---
// The travel map used to live at /projects/map. Trip invites already sent
// point at /projects/map/invite#i=…, so these pages forward to the new
// address and keep the #part, which holds the invite.
export function getStaticPaths() {
  return [undefined, "kim", "invite"].map((path) => ({ params: { path } }));
}

const { path } = Astro.params;
const target = `/sandbox/travel-map${path ? `/${path}` : ""}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>Travel map has moved</title>
    <link rel="canonical" href={target} />
    <script is:inline define:vars={{ target }}>
      location.replace(target + location.hash);
    </script>
    <meta http-equiv="refresh" content={`0;url=${target}`} />
  </head>
  <body>
    <a href={target}>The travel map has moved.</a>
  </body>
</html>
