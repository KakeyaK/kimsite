---
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import TypingTest from "@components/TypingTest.astro";
import { HOME } from "@consts";

const summary = [
  "and this is my personal website. I'll use it to post things I find interesting, and for other random projects!",
  "For now, all my work related stuff will live in LinkedIn only.",
].join("\n");
---

<PageLayout
  title={HOME.TITLE}
  description={HOME.DESCRIPTION}
  class="flex flex-col"
>
  <Container class="flex w-full flex-1 flex-col">
    <TypingTest title="Hi, I'm Kim" text={summary} />
  </Container>
</PageLayout>
