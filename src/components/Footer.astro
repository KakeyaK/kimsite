---
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import { SITE, SOCIALS } from "@consts";
import Sun from "@components/icons/Sun.astro";
import Moon from "@components/icons/Moon.astro";
import System from "@components/icons/System.astro";

const themeButtonClass = [
  "group size-8 flex items-center justify-center rounded-full",
  "transition-colors duration-300 ease-in-out",
  "aria-pressed:bg-black/5 dark:aria-pressed:bg-white/10",
].join(" ");
---

<footer class="animate">
  <Container>
    <div class="flex justify-between items-center">
      <div class="flex flex-wrap gap-x-1 items-center">
        <span>&copy; 2026 {`|`} {SITE.NAME}</span>
        {
          SOCIALS.map((SOCIAL) => (
            <>
              <span>{`/`}</span>
              <Link
                href={SOCIAL.HREF}
                external
                aria-label={`${SITE.NAME} on ${SOCIAL.NAME}`}
              >
                {SOCIAL.NAME}
              </Link>
            </>
          ))
        }
      </div>
      <div class="flex flex-wrap gap-1 items-center">
        <button
          id="light-theme-button"
          aria-label="Light theme"
          aria-pressed="false"
          class={themeButtonClass}
        >
          <Sun />
        </button>
        <button
          id="dark-theme-button"
          aria-label="Dark theme"
          aria-pressed="false"
          class={themeButtonClass}
        >
          <Moon />
        </button>
        <button
          id="system-theme-button"
          aria-label="System theme"
          aria-pressed="false"
          class={themeButtonClass}
        >
          <System />
        </button>
      </div>
    </div>
  </Container>
</footer>