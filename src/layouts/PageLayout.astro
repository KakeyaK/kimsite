---
import Head from "@components/Head.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import SearchPalette from "@components/SearchPalette.astro";
import { SITE } from "@consts";

type Props = {
  title: string;
  description: string;
  class?: string;
  /** Keep the page out of search engines (unlisted pages). */
  noindex?: boolean;
};

const { title, description, class: className, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <Head title={`${title} | ${SITE.NAME}`} description={description} />
    {noindex && <meta name="robots" content="noindex" />}
  </head>
  <body>
    <Header />
    <main class={className}>
      <slot />
    </main>
    <Footer />
    <SearchPalette />
  </body>
</html>
